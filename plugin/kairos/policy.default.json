{
  "version": 1,
  "default": "inherit",
  "rules": [
    {
      "id": "no-credentials",
      "description": "Credential and key files are off-limits to Kairos.",
      "tools": [
        "read_file",
        "write_file",
        "patch",
        "search_files",
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "any_text": [
          "**/.ssh/**",
          "**/hermes/.env",
          "**/hermes/.env.*",
          "**/hermes/auth.json",
          "**/*.pem",
          "**/*.key",
          "**/*.pfx",
          "**/id_rsa*",
          "**/id_ed25519*",
          "**/.aws/credentials",
          "**/.git-credentials",
          "**/.npmrc"
        ]
      },
      "action": "deny"
    },
    {
      "id": "no-credential-store",
      "description": "Windows Credential Manager and other secret stores are off-limits to Kairos.",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\bcmdkey\\b",
          "\\bvaultcmd\\b",
          "Get-StoredCredential",
          "\\bCredRead\\b",
          "\\bgh\\s+auth\\s+token\\b",
          "\\bgit\\s+credential\\b"
        ]
      },
      "action": "deny"
    },
    {
      "id": "no-account-tokens",
      "description": "Account sign-in tokens stay with Hermes and the GitHub CLI; Kairos never reads them (D-010).",
      "tools": [
        "read_file",
        "write_file",
        "patch",
        "search_files",
        "terminal",
        "execute_code"
      ],
      "match": {
        "any_text": [
          "**/hermes/google_token.json",
          "**/hermes/google_oauth_pending.json",
          "**/hermes/google_client_secret*.json",
          "**/gh/hosts.yml"
        ]
      },
      "action": "deny"
    },
    {
      "id": "no-kairos-tampering",
      "description": "Kairos may not change its own rules, records or plugin.",
      "tools": [
        "write_file",
        "patch",
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "any_text": [
          "%APPDATA%/kairos/**",
          "%LOCALAPPDATA%/hermes/plugins/kairos/**"
        ]
      },
      "action": "deny"
    },
    {
      "id": "no-safety-changes",
      "description": "Kairos may not change Hermes's approval mode or turn its own plugin off.",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\bhermes(\\.exe)?\\s+config\\s+(set|unset|edit)\\s+(approvals|plugins|security)",
          "\\bhermes(\\.exe)?\\s+plugins\\s+(disable|remove|uninstall)\\b",
          "\\bhermes(\\.exe)?\\s+.*--yolo\\b"
        ]
      },
      "action": "deny"
    },
    {
      "id": "no-sandbox-changes",
      "description": "The agent must not move its own commands out of the container (D-019); that is the user's setting.",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\bhermes(\\.exe)?\\s+config\\s+(set|unset)\\s+terminal\\.",
          "\\bhermes(\\.exe)?\\s+config\\s+edit\\b"
        ]
      },
      "action": "deny"
    },
    {
      "id": "kairos-plugin-source",
      "description": "Changing the Kairos plugin's source code changes Kairos's own safety rules.",
      "tools": [
        "write_file",
        "patch"
      ],
      "match": {
        "paths": [
          "**/kairos/plugin/**"
        ]
      },
      "action": "ask"
    },
    {
      "id": "kairos-skills",
      "description": "These are Kairos's own skills: changing them changes how Kairos works.",
      "tools": [
        "write_file",
        "patch",
        "skill_manage"
      ],
      "match": {
        "any_text": [
          "**/hermes/skills/kairos/**",
          "**/kairos/skills/kairos/**",
          "kairos-debug-and-fix",
          "kairos-code-review",
          "kairos-documents-to-actions"
        ]
      },
      "action": "ask"
    },
    {
      "id": "destructive-commands",
      "description": "This command deletes or overwrites data that may not be recoverable.",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\brm\\b[^;&|\\n]*\\s-(-recursive\\b|[a-z]*r)",
          "\\bremove-item\\b[^;&|\\n]*-recurse",
          "\\b(del|erase|rd|rmdir)\\b[^;&|\\n]*\\s/s\\b",
          "\\bformat(\\.com)?\\s+[a-z]:",
          "\\bdiskpart\\b",
          "\\bmkfs\\b",
          "\\bdd\\s+[^;&|\\n]*\\bof=",
          "\\bgit\\s+push\\b[^;&|\\n]*\\s(--force\\b|-f\\b|--force-with-lease\\b)",
          "\\bgit\\s+reset\\s+--hard\\b",
          "\\bgit\\s+clean\\b[^;&|\\n]*\\s-[a-z]*f",
          "\\bgit\\s+branch\\s+-D\\b",
          "\\bshutil\\.rmtree\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "run-downloaded-code",
      "description": "This downloads code and runs it straight away, without anyone reading it first.",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\b(curl|wget)\\b[^;&\\n]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b",
          "\\b(curl|wget)\\b[^;&\\n]*\\|\\s*(python3?|node|perl|ruby|pwsh|powershell)\\b",
          "\\b(iwr|irm|invoke-webrequest|invoke-restmethod)\\b[^;&\\n]*\\|\\s*(iex|invoke-expression)\\b",
          "\\b(iex|invoke-expression)\\b",
          "\\b(powershell|pwsh)(\\.exe)?\\b[^;&|\\n]*\\s-(e|ec|enc|encodedcommand)\\s",
          "\\bmshta(\\.exe)?\\b",
          "\\bregsvr32(\\.exe)?\\b[^;&|\\n]*\\s/i:",
          "\\bcertutil(\\.exe)?\\b[^;&|\\n]*-urlcache",
          "\\bbitsadmin(\\.exe)?\\b[^;&|\\n]*/transfer"
        ]
      },
      "action": "ask"
    },
    {
      "id": "system-files",
      "description": "Changing files in Windows or Program Files can break the system or installed programs.",
      "tools": [
        "write_file",
        "patch"
      ],
      "match": {
        "paths": [
          "c:/windows/**",
          "c:/program files/**",
          "c:/program files (x86)/**",
          "c:/programdata/**"
        ]
      },
      "action": "ask"
    },
    {
      "id": "system-changes",
      "description": "This changes Windows itself: system folders, the registry, services, scheduled tasks or boot settings.",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\b(copy|xcopy|robocopy|move|mv|cp|del|erase|rm|rmdir|rd|ren|rename|mkdir|md|new-item|set-content|add-content|out-file|copy-item|move-item|remove-item|rename-item|tee)\\b[^;&|\\n]*[a-z]:[\\\\/]+\\\"?(windows|program files|programdata)\\b",
          ">>?\\s*\\\"?[a-z]:[\\\\/]+(windows|program files|programdata)\\b",
          "\\breg(\\.exe)?\\s+(add|delete|import|load|unload|restore|copy)\\b",
          "\\b(set-itemproperty|new-itemproperty|remove-itemproperty|rename-itemproperty|new-item|set-item|remove-item)\\b[^;&|\\n]*\\b(hklm|hkcu|hkcr|hku|hkcc|registry::)",
          "\\bregedit(\\.exe)?\\b[^;&|\\n]*\\s/s\\b",
          "\\bsc(\\.exe)?\\s+(config|create|delete|stop|failure)\\b",
          "\\b(set|stop|new|remove|restart)-service\\b",
          "\\bschtasks(\\.exe)?\\b[^;&|\\n]*/(create|delete|change)\\b",
          "\\b(register|unregister|set)-scheduledtask\\b",
          "\\bbcdedit(\\.exe)?\\b",
          "\\bnetsh\\b[^;&|\\n]*\\b(firewall|advfirewall)\\b[^;&|\\n]*\\b(set|add|delete)\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "permission-changes",
      "description": "This changes who may read or change files, or what the computer allows to run.",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\bicacls(\\.exe)?\\b[^;&|\\n]*\\s/(grant|deny|remove|reset|setowner|setintegritylevel|inheritance)",
          "\\bcacls(\\.exe)?\\b",
          "\\btakeown(\\.exe)?\\b",
          "\\bset-acl\\b",
          "\\bchmod\\b[^;&|\\n]*\\s-[a-z]*R",
          "\\bchmod\\b[^;&|\\n]*\\s(0?777|a\\+rwx)\\b",
          "\\bchown\\b",
          "\\battrib(\\.exe)?\\b[^;&|\\n]*\\s-[shr]\\b",
          "\\bnet(\\.exe)?\\s+(user|localgroup)\\b[^;&|\\n]*\\s/(add|delete)\\b",
          "\\b(add|remove)-localgroupmember\\b",
          "\\bset-executionpolicy\\b",
          "\\b(set|add)-mppreference\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "kill-system-processes",
      "description": "Ending a Windows system process can crash or log out the computer. Kairos never does it.",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\b(taskkill(\\.exe)?|stop-process|spps|kill|pkill|killall|tskill|wmic(\\.exe)?)\\b[^;&|\\n]*\\b(explorer|winlogon|csrss|lsass|services|svchost|smss|wininit|dwm)(\\.exe)?\\b",
          "\\bget-process\\b[^;&\\n]*\\b(explorer|winlogon|csrss|lsass|services|svchost|smss|wininit|dwm)\\b[^;&\\n]*\\|\\s*(stop-process|spps|kill)\\b"
        ]
      },
      "action": "deny"
    },
    {
      "id": "kill-processes",
      "description": "Ending a program from the command line can lose unsaved work. Use the close_app tool instead: it asks the user and lets the app save first.",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\btaskkill(\\.exe)?\\b",
          "\\btskill\\b",
          "\\b(stop-process|spps)\\b",
          "\\|\\s*kill\\b",
          "(^|[;&|]\\s*)kill\\s+(-\\S+\\s+)*(%?\\d+|\\$\\S+)",
          "\\b(pkill|killall)\\b",
          "\\bwmic(\\.exe)?\\b[^;&|\\n]*\\bprocess\\b[^;&|\\n]*\\b(delete|terminate)\\b",
          "\\.(Kill|terminate)\\s*\\("
        ]
      },
      "action": "ask"
    },
    {
      "id": "run-installers",
      "description": "This starts an installer, which can change the computer.",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\b(start|start-process|saps|invoke-item|ii|cmd\\s+/c\\s+start)\\b[^;&|\\n]*\\S*(setup|install)\\S*\\.exe\\b",
          "(^|[;&|]\\s*)\\.?[\\\\/]?\\S*(setup|install)\\S*\\.exe\\b",
          "\\S\\.msi\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "browser-settings-pages",
      "description": "The browser's own pages (settings, saved passwords, local files) are off limits to Kairos.",
      "tools": [
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\b(goto_url|new_tab|goto)\\s*\\(\\s*(url\\s*=\\s*)?[rbuf]{0,2}['\\\"]\\s*((brave|chrome|edge|opera|vivaldi|file|view-source|devtools|chrome-extension):|about:(?!blank))",
          "\\blocation(\\.href)?\\s*=\\s*['\\\"`]\\s*(brave|chrome|edge|opera|vivaldi|file|view-source|devtools|chrome-extension):"
        ]
      },
      "action": "deny"
    },
    {
      "id": "browser-no-card-numbers",
      "description": "Kairos never types a card number, a password or a security code into a page: the browser vault fills them, after asking you.",
      "tools": [
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\b(type_text|fill_input|dispatch_key)\\s*\\([^)]*['\\\"]\\s*(\\d[ -]?){12,18}\\d\\s*['\\\"]",
          "\\.value\\s*=\\s*['\\\"`]\\s*(\\d[ -]?){12,18}\\d\\s*['\\\"`]",
          "\\bfill_input\\s*\\(\\s*(selector\\s*=\\s*)?[rbuf]{0,2}['\\\"][^'\\\"]*(password|passwd|pwd|passcode|cvc|cvv|csc|card.?number|cc-number|cc-csc|cc-exp|iban|mot.?de.?passe|كلمة)",
          "querySelector(All)?\\s*\\([^)]*(password|cvc|cvv|cc-number|card.?number|iban)[^)]*\\)[^\\n;]*\\.value\\s*=(?!=)"
        ]
      },
      "action": "deny"
    },
    {
      "id": "browser-code-system-access",
      "description": "Browser automation code that reaches beyond the browser (files, programs, the system or its own network requests) needs your OK.",
      "tools": [
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\bimport\\s+(os|subprocess|shutil|pathlib|ctypes|winreg|sys|tempfile|glob)\\b",
          "\\bfrom\\s+(os|subprocess|shutil|pathlib|ctypes|winreg|sys|tempfile|glob)\\b",
          "\\b__import__\\s*\\(",
          "\\b(eval|exec|compile)\\s*\\(",
          "\\bopen\\s*\\(",
          "\\bos\\.(system|popen|remove|unlink|rmdir|rename|replace|chmod|startfile|spawn\\w*|exec\\w*)\\b",
          "\\bimport\\s+(urllib|requests|httpx|socket|ftplib|smtplib|aiohttp)\\b",
          "\\bimport\\s+http\\.client\\b",
          "\\bfrom\\s+(urllib|requests|httpx|socket|http|ftplib|smtplib|aiohttp)\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "browser-page-actions",
      "description": "Browser code that clicks, types, presses keys, submits, uploads, sends raw browser commands, or reads cookies and site storage needs your OK. Reading a page doesn't.",
      "tools": [
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\b(click_at_xy|click|type_text|fill_input|press_key|dispatch_key|upload_file)\\s*\\(",
          "\\b(cdp|_send)\\s*\\(",
          "\\.(click|submit|requestSubmit|dispatchEvent)\\s*\\(",
          "\\bexecCommand\\s*\\(",
          "\\.(value|checked|selected|selectedIndex|innerHTML|innerText|textContent)\\s*=(?!=)",
          "\\bdocument\\.cookie\\b",
          "\\b(localStorage|sessionStorage|indexedDB)\\b",
          "\\b(fetch|sendBeacon)\\s*\\(",
          "\\b(XMLHttpRequest|WebSocket)\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "browser-vault-fill",
      "description": "Filling a saved password or card into a page, or saving a new login, needs your OK.",
      "tools": [
        "browser_vault"
      ],
      "match": {
        "any_text": [
          "fill",
          "save_login"
        ]
      },
      "action": "ask"
    },
    {
      "id": "outbound-messages",
      "description": "Sending a message on your behalf always needs your OK.",
      "tools": [
        "send_message",
        "discord",
        "discord_admin",
        "yb_send_dm",
        "yb_send_sticker"
      ],
      "action": "ask"
    },
    {
      "id": "account-writes",
      "description": "Sending, replying, deleting or changing anything in an account always asks (D-010).",
      "tools": [
        "terminal",
        "execute_code",
        "browser_exec"
      ],
      "match": {
        "commands": [
          "\\bgmail\\s+(send|reply|forward|modify|trash|delete)\\b",
          "\\bcalendar\\s+(create|update|delete)\\b",
          "\\bdrive\\s+(upload|share|delete|create-folder)\\b",
          "\\bsheets\\s+(update|append|create)\\b",
          "\\bdocs\\s+(create|append)\\b",
          "\\bgws\\b[^;&|\\n]*\\b(send|insert|import|modify|batchModify|trash|delete|batchDelete|update|patch|create|copy|move)\\b",
          "\\bhimalaya\\b[^;&|\\n]*\\b(send|reply|forward|write|delete|move|copy)\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "account-disconnect",
      "description": "Disconnecting or re-authorising an account is the user's call; Settings > Accounts does it.",
      "tools": [
        "terminal",
        "execute_code"
      ],
      "match": {
        "commands": [
          "\\bsetup\\.py\\b[^;&|\\n]*--revoke\\b",
          "\\$\\{?GSETUP\\}?[^;&|\\n]*--revoke\\b",
          "\\bgh\\s+auth\\s+(logout|refresh|switch)\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "scheduled-jobs",
      "description": "Scheduling unattended work, or changing or removing a scheduled job, is the user's call (M8 §5).",
      "tools": [
        "cronjob_manage"
      ],
      "match": {
        "any_text": [
          "create",
          "update",
          "resume",
          "remove"
        ]
      },
      "action": "ask"
    },
    {
      "id": "scheduled-jobs-cli",
      "description": "Scheduling unattended work from the command line is the user's call (M8 §5).",
      "tools": [
        "terminal",
        "execute_code"
      ],
      "match": {
        "commands": [
          "\\bhermes(\\.exe)?\\s+cron\\s+(add|create|edit|resume|remove|rm|delete)\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "delegate-to-agents",
      "description": "Handing work to another agent can spend money and change code.",
      "tools": [
        "delegate_task",
        "a2a_call",
        "a2a_orchestrate"
      ],
      "action": "ask"
    },
    {
      "id": "delegate-cli",
      "description": "Running Claude Code, Codex or OpenCode can spend money and change code.",
      "tools": [
        "terminal"
      ],
      "match": {
        "commands": [
          "(^|[;&|]\\s*|\\bnpx\\s+)(claude|codex|opencode)(\\.exe|\\.cmd)?(\\s|$)"
        ]
      },
      "action": "ask"
    },
    {
      "id": "git-publish",
      "description": "Publishing to GitHub is visible to others.",
      "tools": [
        "terminal"
      ],
      "match": {
        "commands": [
          "\\bgit\\s+push\\b",
          "\\bgh\\s+pr\\s+(create|merge|close|comment|review|edit)\\b",
          "\\bgh\\s+release\\s+(create|delete|edit)\\b",
          "\\bgh\\s+issue\\s+(create|comment|close|edit|delete)\\b",
          "\\bgh\\s+repo\\s+(create|delete|edit|rename)\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "install-software",
      "description": "Installing or removing software changes your computer.",
      "tools": [
        "terminal"
      ],
      "match": {
        "commands": [
          "\\b(winget|choco|scoop)\\s+(install|upgrade|uninstall|remove)\\b",
          "\\bpip3?\\s+(install|uninstall)\\b",
          "\\bpython3?(\\.exe)?\\s+-m\\s+pip\\s+(install|uninstall)\\b",
          "\\bnpm\\s+(i|install|uninstall)\\b[^;&|\\n]*\\s(-g|--global)\\b",
          "\\bpnpm\\s+(add|i|install|remove)\\b[^;&|\\n]*\\s(-g|--global)\\b",
          "\\bcargo\\s+(install|uninstall)\\b",
          "\\buv\\s+tool\\s+install\\b",
          "\\bmsiexec\\b"
        ]
      },
      "action": "ask"
    },
    {
      "id": "system-processes",
      "description": "Closing a Windows system process can crash or log out the computer.",
      "tools": [
        "close_app"
      ],
      "match": {
        "any_text": [
          "explorer",
          "explorer.exe",
          "winlogon",
          "winlogon.exe",
          "csrss",
          "csrss.exe",
          "lsass",
          "lsass.exe",
          "services",
          "services.exe",
          "svchost",
          "svchost.exe",
          "smss",
          "smss.exe",
          "wininit",
          "wininit.exe",
          "dwm",
          "dwm.exe"
        ]
      },
      "action": "deny"
    },
    {
      "id": "close-apps",
      "description": "Closing an app can lose unsaved work.",
      "tools": [
        "close_app"
      ],
      "action": "ask"
    },
    {
      "id": "open-installers",
      "description": "Installers and uninstallers change what is on the PC.",
      "tools": [
        "open_app"
      ],
      "match": {
        "any_text": [
          "*install*",
          "*setup*"
        ]
      },
      "action": "ask"
    },
    {
      "id": "open-apps",
      "description": "Opening an app from the Start menu is allowed.",
      "tools": [
        "open_app"
      ],
      "action": "allow"
    },
    {
      "id": "screen-capture",
      "description": "A screenshot can show anything on the screen; the user decides each time (D-021).",
      "tools": [
        "screen_capture"
      ],
      "action": "ask"
    }
  ]
}
